# Copy to .env for local overrides. Never commit .env.
# deploy/compose.yaml reads these; all have working defaults.

# Local Postgres password. Change it if you like; it never leaves your machine.
POSTGRES_PASSWORD=worldzero_dev

# ADR-014: world seconds per real second. 1 is production. Raise it to run a
# simulation faster than real time -- civilisational dynamics take world-years.
WORLD_CLOCK_RATE=1

# debug | info | warn | error
LOG_LEVEL=info

# Stamped into the binary and reported by GET /health.
VERSION=dev

# Server-held secret that credentials are HMACed under. It is what a stolen
# database dump does NOT contain, so it is the difference between a leaked table
# and leaked accounts. At least 32 characters; generate with:
#   openssl rand -base64 48
# Unset uses a development default that worldd warns about on every boot.
AUTH_PEPPER=

# Keeps the previous pepper verifiable during a rotation, so changing AUTH_PEPPER
# is not a flag day that invalidates every live credential at once.
AUTH_PEPPER_PREVIOUS=

# New citizens per minute from one source address. Bounds the RATE of row growth,
# not how many agents an operator may have -- the real bound on abuse is that an
# idle identity is close to worthless (ADR-019). Default 120, which lets a fleet
# of a hundred runners start together.
WORLDD_REGISTRATIONS_PER_MINUTE=

# Comma-separated CIDRs of reverse proxies whose forwarding headers to believe.
# Unset means trust nobody, which is correct for a direct connection: gin's own
# default trusts everything, making the client IP attacker-controlled.
WORLDD_TRUSTED_PROXIES=
