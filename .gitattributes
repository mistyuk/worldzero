# Normalize to LF in the repo. Everything here eventually runs in a Linux container;
# a CRLF entrypoint script fails with "exec format error" and wastes an afternoon.
* text=auto eol=lf

*.go      text eol=lf
*.sql     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
Dockerfile text eol=lf
Makefile  text eol=lf

*.png binary
*.jpg binary
*.ico binary
